# Copie para .env.local e preencha. Nunca commite .env.local.
# Tudo aqui é de TESTNET (Sepolia). Nunca use chaves ou fundos de mainnet.

# --- Banco (docker compose up -d db) ---
DATABASE_URL=postgres://mb:mb@127.0.0.1:5433/mb_wallet_bridge

# --- Privy (dashboard.privy.io) ---
# App ID é público (vai para o navegador); o secret fica só no servidor.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Blockchain ---
# RPC Sepolia (Alchemy, Infura, QuickNode...). Para testes locais: http://127.0.0.1:8545 (anvil)
RPC_URL=
# Chave privada da tesouraria (EOA de teste, com Sepolia ETH de faucet). Só no servidor.
TREASURY_PRIVATE_KEY=
# Endereço do MockUSDC implantado (saída do script de deploy em contracts/)
NEXT_PUBLIC_TOKEN_ADDRESS=
# Explorador usado nos links "Ver comprovante"
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# --- Regras da demonstração ---
# E-mails que podem entrar (separados por vírgula)
DEMO_EMAILS=
# Saldo inicial da Conta MB por conta de demonstração (2 casas)
INITIAL_BALANCE=1000.00
# Confirmações exigidas antes de considerar uma transação definitiva
CONFIRMATIONS=2
# Minutos de espera antes de cancelar uma transação presa
OBSERVATION_WINDOW_MIN=10
# Blocos por chamada de eth_getLogs na varredura de entradas. O plano gratuito da Alchemy
# aceita no máximo 10; aumente se o seu RPC permitir faixas maiores.
SCAN_CHUNK_BLOCKS=10
